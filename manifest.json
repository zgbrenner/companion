{
  "manifest_version": 3,
  "name": "COMPANION",
  "version": "1.4.1",
  "minimum_chrome_version": "111",
  "description": "Private Claude and ChatGPT usage tools with local Lifejacket prompt compression and file-to-Markdown conversion.",
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "offscreen",
    "alarms"
  ],
  "host_permissions": [
    "https://claude.ai/*",
    "https://*.claude.ai/*",
    "https://chatgpt.com/*",
    "https://*.chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; worker-src 'self'; object-src 'none'; base-uri 'none'; connect-src 'self' https://claude.ai https://*.claude.ai https://chatgpt.com https://*.chatgpt.com https://chat.openai.com; img-src 'self' data:; style-src 'self' 'unsafe-inline';",
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:; worker-src blob:; child-src blob:; connect-src blob: data:; object-src 'none'; base-uri 'none';"
  },
  "sandbox": {
    "pages": [
      "src/sandbox.html"
    ]
  },
  "background": {
    "service_worker": "src/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "src/shared.js",
        "src/lifejacket-settings.js",
        "src/lifejacket-core.js",
        "src/native-usage.js",
        "src/content.js",
        "src/lifejacket-content.js"
      ],
      "css": [
        "src/brand-fonts.css",
        "src/content.css"
      ],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ],
      "js": [
        "src/injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/shared.js",
        "src/lifejacket-settings.js",
        "src/lifejacket-core.js",
        "src/platform.js",
        "src/openai-freshness.js",
        "src/openai-channel.js",
        "src/openai-content.js",
        "src/openai-freshness-ui.js",
        "src/lifejacket-content.js"
      ],
      "run_at": "document_start",
      "css": [
        "src/brand-fonts.css"
      ]
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": [
        "src/openai-observer.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/widget.css",
        "src/fonts/league-spartan-bold.woff2",
        "src/fonts/atkinson-hyperlegible-next-variable.woff2",
        "src/lifejacket.css"
      ],
      "matches": [
        "https://claude.ai/*",
        "https://*.claude.ai/*"
      ]
    },
    {
      "resources": [
        "src/openai-widget.css",
        "src/fonts/league-spartan-bold.woff2",
        "src/fonts/atkinson-hyperlegible-next-variable.woff2",
        "src/lifejacket.css"
      ],
      "matches": [
        "https://chatgpt.com/*",
        "https://*.chatgpt.com/*",
        "https://chat.openai.com/*"
      ]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "COMPANION",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_popup": "src/popup-router.html"
  },
  "options_page": "src/options-lifejacket.html"
}
